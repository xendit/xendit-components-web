{
  "name": "xendit-components-web",
  "version": "0.0.19",
  "description": "Xendit frontend payment components SDK",
  "type": "module",
  "author": "Xendit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xendit/xendit-components-web"
  },
  "keywords": [
    "xendit",
    "payment",
    "payments",
    "payment processing",
    "credit cards",
    "checkout",
    "components"
  ],
  "files": [
    "./sdk/dist/",
    "./README.md",
    "./CHANGELOG.md"
  ],
  "types": "./sdk/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/dist/index.d.ts",
      "node": {
        "import": "./sdk/dist/esm-external/index.mjs",
        "require": "./sdk/dist/cjs/index.cjs"
      },
      "browser": {
        "import": "./sdk/dist/esm-bundled/index.mjs",
        "require": "./sdk/dist/index.umd.js"
      },
      "import": "./sdk/dist/esm-bundled/index.mjs",
      "require": "./sdk/dist/index.umd.js",
      "default": "./sdk/dist/esm-bundled/index.mjs"
    }
  },
  "scripts": {
    "dev": "./build.ts dev",
    "build": "./build.ts prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:debug": "vitest run --printConsoleTrace=true --silent=false",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --check --write",
    "prepare": "husky"
  },
  "dependencies": {
    "card-validator": "^10.0.4",
    "classnames": "^2.5.1",
    "libphonenumber-js": "^1.12.41",
    "preact": "^10.29.0",
    "qrcode": "^1.5.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "^1.9.1",
    "@eslint/js": "^9.39.3",
    "@microsoft/api-extractor": "^7.57.8",
    "@preact/preset-vite": "^2.10.5",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/googlepay": "^0.7.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "mime-types": "^3.0.2",
    "prettier": "^3.8.1",
    "rollup": "^4.60.1",
    "rollup-plugin-import-css": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "4.1.2"
  },
  "packageManager": "pnpm@10.28.1"
}
